{
  "name": "omp-kiro",
  "version": "0.2.0",
  "description": "Use Kiro CLI as an Oh My Pi model provider while keeping OMP in control of tools.",
  "keywords": [
    "extension",
    "kiro",
    "model-provider",
    "oh-my-pi",
    "omp"
  ],
  "homepage": "https://github.com/emotionbug/omp-kiro#readme",
  "bugs": {
    "url": "https://github.com/emotionbug/omp-kiro/issues"
  },
  "license": "Apache-2.0",
  "author": "Alex Kwak",
  "repository": {
    "type": "git",
    "url": "https://github.com/emotionbug/omp-kiro.git"
  },
  "files": [
    "index.js",
    "*.mjs",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "node --check index.js && node --check bridge.mjs && node --check setup.mjs && node --check auth.mjs && node --check http.mjs && node --check eventstream.mjs",
    "lint": "oxlint index.js *.mjs test",
    "test": "node --test test/*.test.mjs",
    "setup:paseo": "node setup.mjs"
  },
  "devDependencies": {
    "oxlint": "1.61.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.12.6"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "omp": {
    "extensions": [
      "./index.js"
    ]
  }
}
